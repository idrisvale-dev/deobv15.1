local function httpRequest(label)
	return function(...)
		local opts = ...
		-- a C function: bad arguments raise a typed error (Script42 calls request()
		-- 197 coroutines deep and checks the message for "C stack overflow")
		if R.type(opts) ~= "table" then
			argError(1, R.match(label, "([%w_]+)$"), "table", ...)
		end
		if R.type(opts.Url) == "string" then remember(urls, opts.Url) end
		-- CENTURION-PORT: --cfg httpresps={"url=body"} replays frozen live
		-- HTTP bodies as real response tables (6th sample gates composition
		-- on platoboost /public/connectivity). State on CFG._http: the
		-- top-level chunk is at the 200-local limit, no new module locals.
		if R.type(opts.Url) == "string" then
			if CFG._http == nil then
				CFG._http = {}
				local hl = CFG.httpresps
				if R.type(hl) == "table" then
					for _, e in R.ipairs(hl) do
						local hk, hv = R.match(e, "^([^=]*)=(.*)$")
						if hk then CFG._http[hk] = hv end
					end
				end
			end
			local frozen = CFG._http[opts.Url]
			if frozen == nil then
				-- CENTURION-PORT: prefix fallback for query-varying endpoints
				-- (platoboost /whitelist carries a random per-request nonce;
				-- the frozen snapshot is pinned to the stub identity anyway).
				-- Longest pack key that prefixes the URL wins.
				local best, bestn = nil, -1
				for hk, hv in R.pairs(CFG._http) do
					if R.type(hk) == "string" and #hk > bestn and R.sub(opts.Url, 1, #hk) == hk then
						best, bestn = hv, #hk
					end
				end
				frozen = best
			end
			if frozen ~= nil then
				-- CENTURION-PORT: log frozen replays (driver verifies which
				-- frozen responses the composition actually consumed).
				R.print("CENT-HTTPHIT " .. opts.Url)
				return { Success = true, StatusCode = 200, StatusMessage = "OK", Body = frozen, Headers = {} }
			end
		end
		return callP(label .. "(" .. fmt(opts) .. ")", "response", "table")
	end
end
