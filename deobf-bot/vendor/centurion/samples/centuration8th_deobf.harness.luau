end
-- CENTURION-PORT: sorted-pairs experiment (branch-dependence probe).
-- If decode keystream iterates string-keyed tables, hash order (which can
-- differ across Luau builds) changes results. With centurion_sortpairs,
-- plain tables with NO array part iterate string keys sorted; everything
-- else (proxies, sequences, mixed) keeps real order.
if CFG.centurion_sortpairs then
	local __realPairsFn = E.pairs
	E.pairs = function(t)
		if isP(t) then return iterProxy(t, "pairs"), t, nil end
		if R.type(t) == "table" then
			local hasArr, keys, okK = false, {}, true
			for k in R.pairs(t) do
				if R.type(k) == "number" and k >= 1 and k == math.floor(k) then hasArr = true break end
				if R.type(k) ~= "string" then okK = false break end
				table.insert(keys, k)
			end
			if okK and not hasArr and #keys > 1 then
				table.sort(keys)
				local i = 0
				return function()
					i += 1
					local k = keys[i]
					if k == nil then return nil end
					return k, t[k]
				end
			end
		end
		return __realPairsFn(t)
	end
end
E.ipairs = function(...)
	local t = ...
	if isP(t) then return iterProxy(t, "ipairs"), t, 0 end
	return R.ipairs(...)
end
-- The real pcall/xpcall: Luraph looks at the call stack from inside a
-- protected call (debug.info(3, "f") must be the xpcall it holds), so these
-- cannot be wrapped. Our stop signals may therefore be swallowed by a script
-- pcall; they are re-raised on the next opportunity instead (see STICKY).
	E.pcall = R.pcall
	-- CENTURION-PORT: log every script-visible pcall/xpcall outcome (ok +
	-- message head). Probe gates hide inside VM bytecode where the statement
	-- tracer cannot see them; unexpected pcall sites (e.g. around decode or
	-- size reads with fallback paths) only surface here.
	if CFG.centurion_pcallog then
		R.print("CENT-CFG firsttwo=" .. R.tostring(CFG.centurion_firsttwo) .. " oob=" .. R.tostring(CFG.centurion_oob ~= nil and true or false))
		local __pcallN = 0
		local function __logPcall(tag, res)
			__pcallN += 1
			local fail = not res[1]
			if fail or __pcallN <= 40 then
				local msg = ""
				if fail then msg = " ERR=" .. R.sub(R.tostring(res[2]), 1, 90)
				else
					-- CENTURION-PORT: return shape matters as much as ok-flag
					-- (a clean pcall returning different VALUES diverges).
					local rv = res[2]
					msg = " ret=" .. R.tostring(R.typeof(rv))
					if R.type(rv) == "string" then msg ..= ":" .. R.sub(rv, 1, 60) end
					if R.type(rv) == "number" then msg ..= ":" .. R.tostring(rv) end
				end
				-- CENTURION-PORT: statement index locates the call in flow.
				local st = ""
				local okS, blk = R.pcall(curBlock)
				if okS and R.type(blk) == "table" and R.type(blk.lines) == "table" then
					st = " stmts=" .. #blk.lines
				end
				local where = ""
				if fail then
					local okTb, tb = R.pcall(debug.traceback, "", 2)
					if okTb then where = " TB=" .. R.sub(R.gsub(tb, "\n", "|"), 1, 160) end
				end
				R.print("CENT-PCALL #" .. __pcallN .. " " .. tag .. " ok=" .. R.tostring(res[1]) .. msg .. st .. where)
			end
		end
		E.pcall = function(...)
			local f = ...
			local res = table.pack(R.pcall(...))
			__logPcall("pcall@" .. (isP(f) and R.tostring(INFO[f].name or INFO[f].hint) or R.tostring(CNAME[f]) or R.type(f)), res)
			-- CENTURION-PORT: first-two-returns experiment. Live baseplate
			-- shows the first 2 pcalls returning boolean where offline yields
			-- number; the branch right after decides everything. Modes: 1 =
			-- force true, 2 = force false (numeric first-returns only).
			local ft = CFG.centurion_firsttwo or 0
			if ft ~= 0 and __pcallN <= 2 and res[1] and R.type(res[2]) == "number" then
				R.print("CENT-FORCE firsttwo=" .. ft)
				res[2] = (ft == 1)
			end
			return R.unpack(res, 1, res.n)
		end
		E.xpcall = function(...)
			local res = table.pack(R.xpcall(...))
			__logPcall("xpcall", res)
			return R.unpack(res, 1, res.n)
		end
		E.ypcall = function(...)
			local res = table.pack(R.pcall(...))
			__logPcall("ypcall", res)
			return R.unpack(res, 1, res.n)
		end
	end
-- (E.ypcall alias preserved: wrapped above when pcallog is on,
-- otherwise the E-table default from the environment definition.)
E.xpcall = R.xpcall
-- the real getfenv: the script runs in a thread whose globals are ENV (see the
-- runner below), so getfenv(0)/getfenv() already return ENV. A Lua wrapper here
-- would add a stack frame on every VM call, which Luraph notices through the
-- position in its stack-overflow probe's error message.
E.getfenv = R.getfenv
E.setfenv = function(x, env)
	if R.type(x) == "number" then
		return R.setfenv(x == 0 and 0 or x + 1, env)
	end
	-- a C function's environment cannot be changed; Luraph tests exactly this
	if CFUNCS[x] or isP(x) or (R.type(x) == "function" and debug.info(x, "s") == HARNESS_SRC0) then
		R.error("'setfenv' cannot change environment of given object", 0)
	end
	return R.setfenv(x, env)
end
E.print = function(...)
	emit({ text = "print(" .. fmtArgs(...) .. ")" })
end
E.warn = function(...)
	emit({ text = "warn(" .. fmtArgs(...) .. ")" })
