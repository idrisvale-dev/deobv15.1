end, {
	__eq = function(a, b) return TYPE[a] == TYPE[b] and VAL[a].lo == VAL[b].lo and VAL[a].hi == VAL[b].hi end,
	__tostring = function(a) return g(VAL[a].lo) .. " " .. g(VAL[a].hi) .. " " end,
})
local NRLib = {
	new = function(lo, hi)
		lo = f32(num(lo))
