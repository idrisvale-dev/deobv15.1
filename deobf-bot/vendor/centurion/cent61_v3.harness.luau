			b.tostring = function(buf, ...)
				local ok, out = R.pcall(__centPrevTostring, buf, ...)
				if ok and R.type(out) == "string" and #out >= 12 and __centSTRn < 40 then
					__centSTRn += 1
					local prev = R.sub(out, 1, 120)
					prev = R.gsub(prev, "[%c%z]", ".")
					R.print("CENT-STR len=" .. #out .. " " .. prev)
				end
				if ok then return out end
				return ""
			end
		end
		for _, rn in R.ipairs({ "readu8", "readu16", "readu32", "readi8", "readi16", "readi32", "readf32", "readf64", "readstring" }) do
