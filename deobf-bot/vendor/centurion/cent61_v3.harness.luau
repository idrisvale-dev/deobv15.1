					if ok then return out end
					if R.type(off) == "number" and off < 0 then
						-- CENTURION-PORT diagnostic: on the very first dict
						-- fallback, show what EVERY candidate holds at its
						-- len+off window so the true dictionary can be picked.
						-- (Kept small: first fallback only.)
						if __centOOBn == 0 and CFG.centurion_dictscan then
							for _, cand2 in R.ipairs(__centRefs) do
								local okL2, ln2 = R.pcall(buffer.len, cand2)
								if okL2 and ln2 + off >= 0 and ln2 < 50000000 then
									local okB, bb = R.pcall(rf, cand2, ln2 + off)
