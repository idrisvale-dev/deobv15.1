				-- requests with a capped zero buffer instead of size 0, so a
				-- wrong-branch size still lets decode run to completion and
				-- emit whatever strings/stages survive (v6-style 99% recovery
				-- measurement). Only for positive numbers above the cap.
				if CFG.centurion_bigzero and R.type(n) == "number" and n > CFG.centurion_bigzero then
					return nativeCreate(CFG.centurion_bigzero)
				end
				if CFG.v14_lenient_create then return nativeCreate(0) end
			end
			R.error(out, 0)
		end
