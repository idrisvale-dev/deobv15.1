						-- first-match rule grabs ancient init buffers holding
						-- padding (17s) or zeros while the true dictionary
						-- (previous decode stage, high-entropy bytes) sits
						-- later in creation order. Score each candidate by
						-- byte variance over a 14-byte window; highest wins.
						-- Falls back to first-match when all score zero.
						local best, bestScore, bestVal = nil, -1, nil
