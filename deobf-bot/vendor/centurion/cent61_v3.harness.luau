										local okB, bb = R.pcall(rf, cand, ln + off + j)
										if not okB then good = false break end
										if first == nil then first = bb end
										if not seen[bb] then seen[bb] = true score += 1 end
									end
									if good and score > bestScore then
										bestScore, best, bestVal = score, cand, first
									end
								end
							end
						end
						if best then
							__centOOBn += 1
							if __centOOBn <= __centCap then R.print("CENT-DICTFIX " .. rn .. " idx=" .. off .. " v=" .. R.tostring(bestVal)) end
							local ok2, out2 = R.pcall(rf, best, buffer.len(best) + off, ...)
							if ok2 then return out2 end
						end
						for _, cand in R.ipairs(__centRefs) do
							if cand ~= buf then
								local okL, ln = R.pcall(buffer.len, cand)
								if okL and ln + off >= 0 then
									local ok2, out2 = R.pcall(rf, cand, ln + off, ...)
									if ok2 then
										__centOOBn += 1
										if __centOOBn <= __centCap then R.print("CENT-DICTFIX " .. rn .. " idx=" .. off .. " v=" .. R.tostring(out2) .. " ln=" .. ln) end
										return out2
									end
								end
							end
						end
					end
					__centOOBn += 1
					if __centOOBn <= __centCap then R.print("CENT-OOB " .. rn .. " idx=" .. R.tostring(off)) end
