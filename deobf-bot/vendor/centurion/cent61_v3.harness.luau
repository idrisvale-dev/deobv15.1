	-- Centurion decoders read past short/junk buffers (negative indices
	-- address a dictionary buffer, like v6's 59KB dict stage) and the
	-- payload keeps decoding on zeros. Track every created buffer; on a
	-- failed read with negative offset, retry into each other buffer at
	-- len+offset (first success wins); otherwise log once and return
	-- zero/empty so decode runs to completion for measurement.
	if CFG.centurion_oob then
		local __centRefs, __centOOBn, __centSTRn = {}, 0, 0
		local __centCap = CFG.centurion_oob_cap or 15
		local __centPrevCreate = b.create
		b.create = function(n)
			local buf = __centPrevCreate(n)
			R.insert(__centRefs, buf)
			return buf
		end
